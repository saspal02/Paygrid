# Copy this file to k8s/k8s-secrets.env and fill in your own values.
#
#   cp k8s/k8s-secrets.env.example k8s/k8s-secrets.env
#
# scripts/run-local.sh does this for you and replaces the three cryptographic
# keys below with freshly generated ones.
#
# These placeholder values are public and must be replaced before any real use.

# --- Cryptographic keys -----------------------------------------------------
# The values below are valid but PUBLIC. Replace them before any real use.
#
# JWT_SECRET is used as a raw string by Keys.hmacShaKeyFor(), so it must be at
# least 32 characters long. It is NOT base64-decoded.
# Generate with: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=IqBrm7uiSorZzDlMu804kDCJzXh01gvVLgLY5o4LQb5h75mTx5l1Rf6O3pCqGgwK

# VAULT_MASTER_KEY and WEBHOOK_SECRET are base64-decoded into an AES key, so
# they must decode to exactly 16, 24 or 32 bytes.
# Generate with: openssl rand -base64 32
VAULT_MASTER_KEY=4hV/TyOht6HF8Ys9AwLw8iUMl9FcCKEnTpohLS+ddzo=
WEBHOOK_SECRET=lOKM5fGj7bhTQnCzacQ1JIHFmZyBD9hQ69fcmu0SrS8=

# --- Infrastructure ---------------------------------------------------------
# PSQL_USER is the Postgres superuser that runs the init script.
PSQL_USER=paygrid
PSQL_PASSWORD=paygrid

# One password per service database user, created by the Postgres init script.
MERCHANT_DB_PASSWORD=paygrid
PAYMENT_DB_PASSWORD=paygrid
OPERATIONS_DB_PASSWORD=paygrid
VAULT_DB_PASSWORD=paygrid

REDIS_PASSWORD=paygrid

# --- External config repository ---------------------------------------------
# Git repository the config service reads application config from.
# Fork https://github.com/saspal02/distributed-payment-gateway-config and point
# this at your own copy. The default branch must stay named "main".
GITHUB_URI=https://github.com/saspal02/distributed-payment-gateway-config

# Only needed if the repository above is private. The default one is public,
# so these can stay empty.
GITHUB_USERNAME=
CONFIG_PASSWORD=

# --- Observability ----------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin
